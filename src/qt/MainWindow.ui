                  <widget class="QPushButton" name="batchTrainingCubeButton">
                   <property name="text">
                    <string>Hyperspectral Image</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1">
                  <widget class="QLineEdit" name="batchTrainingCubeEdit">
                   <property name="readOnly">
                    <bool>true</bool>
                   </property>
                   <property name="placeholderText">
                    <string>Select hyperspectral image</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="0">
                  <widget class="QLabel" name="batchClassifierLabel">
                   <property name="text">
                    <string>Classifier:</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="1">
                  <widget class="QComboBox" name="batchClassifierCombo">
                   <property name="toolTip">
                    <string>Select a classifier</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="0" colspan="2">
                  <widget class="QCheckBox" name="batchSeparateLeavesCheck">
                   <property name="text">
                    <string>Separate leaves into individual classes</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="batchOutputGroup">
            <property name="title">
             <string>Output</string>
            </property>
            <layout class="QGridLayout" name="batchOutputLayout">
             <item row="0" column="0">
              <widget class="QPushButton" name="batchOutputDirButton">
               <property name="text">
                <string>Output Folder</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="batchOutputDirEdit">
               <property name="readOnly">
                <bool>true</bool>
               </property>
               <property name="placeholderText">
                <string>Select output folder</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="batchFormatLabel">
               <property name="text">
                <string>Format:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QComboBox" name="batchFormatCombo"/>
             </item>
             <item row="2" column="0" colspan="2">
              <widget class="QCheckBox" name="batchOverwriteCheck">
               <property name="text">
                <string>Overwrite existing files</string>
               </property>
              </widget>
             </item>
             <item row="3" column="0" colspan="2">
              <widget class="QCheckBox" name="batchExportCsvCheck">
               <property name="text">
                <string>Export summary CSV per file</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="batchRunButton">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="text">
             <string>Run Batch</string>
            </property>
            <property name="primaryButton" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QProgressBar" name="batchProgressBar">
            <property name="value">
             <number>0</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="batchStatusLabel">
            <property name="text">
             <string>Select files to begin</string>
            </property>
            <property name="statusMessage" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="batchOptionsSpacer">
            <property name="orientation">
             <enum>Qt::Orientation::Vertical</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>40</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
